MONGODB_URI=mongodb://127.0.0.1:27017/dental_ai
PORT=5000
JWT_SECRET=your_jwt_secret

# Origins allowed to call this API. Comma-separated. Leave unset to allow any origin
# (development only) — set it to your deployed frontend URL in production.
CORS_ORIGINS=http://localhost:5173

# Base URL of the Python/Flask inference service.
AI_SERVICE_URL=http://127.0.0.1:5002

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

ADMIN_EMAIL=your_admin_email@example.com

# Credentials for the seed scripts (node seedAdmin.js / node seedDoctor.js).
# These are never committed and the seeds refuse to run against a non-local database.
SEED_ADMIN_EMAIL=your_admin_email@example.com
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_PASSWORD=choose_a_long_local_password
SEED_DOCTOR_EMAIL=priya.menon@dentaai.com
SEED_DOCTOR_PASSWORD=choose_a_long_local_password
