# Optional Deployment Configuration
# Copy this file to .deploy.env to enable instant webhook-triggered deploys.
# If left unset, scripts/deploy.js deploys automatically via GitHub synchronization.

# Render Deploy Hooks (Find in Render Dashboard > Service > Settings > Deploy Hook)
# RENDER_BACKEND_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxxxxxx?key=yyyyyyyy
# RENDER_AI_DEPLOY_HOOK=https://api.render.com/deploy/srv-zzzzzzzz?key=wwwwwwww

# Vercel Deploy Hook (Find in Vercel Dashboard > Project Settings > Git > Deploy Hooks)
# VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/prj_xxxxxxxx/yyyyyyyy

